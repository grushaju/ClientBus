<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>kit.penny.clientbus</groupId>
    <artifactId>connector-dikidi</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>connector-dikidi</name>
    <description>Stage 13.4: DIKIDI chat channel connector on the shared technical client (integration/dikidi); CRM adapter stays independent</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>kit.penny.clientbus</groupId>
            <artifactId>common</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>kit.penny.clientbus</groupId>
            <artifactId>connector-api</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!-- 13.4: чатовый канал живёт на том же техническом клиенте, что и CRM;
             зависимости от crm/api и crm/dikidi здесь нет и не будет. -->
        <dependency>
            <groupId>kit.penny.clientbus</groupId>
            <artifactId>integration-dikidi</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!-- Только форма ответа chat API (data.list) — разбор подтверждения C02. -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>3.1.4</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- 13.5: контроллер управления каналом (connect/disconnect) собирается сборкой сервера. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Библиотека: без repackaging. spring-boot-maven-plugin не применяется. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
