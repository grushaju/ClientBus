<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>kit.penny.clientbus</groupId>
    <artifactId>integration-dikidi</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>integration-dikidi</name>
    <description>Stage 13.4: technical DIKIDI integration (auth, session, HTTP transport, regulator) with its own technical contract; CRM adapter and chat connector share one DikidiClient</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- 13.4: транспорт — только JDK (java.net.http). CRM-контракты (crm/api)
             и Spring здесь запрещены планом этапа: технический контракт собственный.
             Jackson нужен только рукопожатию входа (html/csrf поле ответа). -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>3.1.4</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Библиотека: без repackaging. spring-boot-maven-plugin не применяется. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
