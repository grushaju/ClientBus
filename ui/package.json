{
  "name": "clientbus-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "test": "node --test tests",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:e2e:types": "tsc --project e2e/tsconfig.json",
    "test:inbox": "node --test tests/inbox.test.cjs tests/inbox.react.test.cjs",
    "test:employees": "node --test tests/employeeDetails.react.test.cjs",
    "test:messages": "node --test tests/messages.react.test.cjs",
    "test:client-details": "node --test tests/conversationClient.react.test.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
